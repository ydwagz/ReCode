# Copy this file to ".env" (same folder as manage.py) and fill it in.
# .env is ignored by git, so your password never gets committed.
#
# Gmail:
#   1. Turn on 2-Step Verification for your Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below (not your normal password).
#   4. Restart runserver, then test with:  python manage.py sendtestemail you@gmail.com

RECODE_EMAIL_HOST=smtp.gmail.com
RECODE_EMAIL_PORT=587
RECODE_EMAIL_USER=you@gmail.com
RECODE_EMAIL_PASSWORD=your16charapppassword

# Optional:
# RECODE_EMAIL_FROM=ReCode <you@gmail.com>
# RECODE_EMAIL_TLS=1      # STARTTLS on port 587 (default)
# RECODE_EMAIL_SSL=1      # use instead of TLS for port 465
